@phdthesis{UCLA2025Dissertation,
  title={More or Less Alive: Labor and Race in Comics' Vital Aesthetics},
  school={University of California, Los Angeles},
  month={December},
  year={2025},
  abstract={MORE OR LESS ALIVE examines the connection between the unsustainable conditions of overwork, underpay, and instability in which most comics are produced and the recurring figures of overflowing vitality that populate the comics page. I show that graphic form has increasingly been framed by its potential to enliven data, history, and text in general: an untapped aesthetic resource that offers vitalizing solutions to other fields and that propagates, as byproducts, genres like graphic medicine, comics journalism, and data comics. These assertions of comics' inexhaustible potential draw from the medium’s identification with polymorphous, hyper-productive, and yet pathologized vitality, exemplified by Art Spiegelman’s description of the medium as a plasticized body and an “amphetamine-riddled art.” I read these fantasies of unfettered life/form with an eye to the relationship between the work of producing visual culture and the work that visual culture is expected to perform, using comics by Justin Green, David Wojnarowicz, James Romberg, Marguerite Van Cook, Hellen Jo, Sloane Long, Miné Okubo, Richie Pope, and Michael Kennedy as my case studies and interlocutors.},
  html={https://escholarship.org/uc/item/4wq6m45m#main},
  additional_info={. Ph.D. Dissertation supervised by [Rachel C. Lee](https://english.ucla.edu/people-faculty/lee-rachel-c)},
  preview={Hong-1.png}
}

